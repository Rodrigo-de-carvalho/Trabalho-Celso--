# ============================================================
#  EXEMPLO DE CONFIGURAÇÃO LOCAL
# ============================================================
# Copie este arquivo para ".env" (que NÃO vai para o Git) e ajuste
# o usuário e a senha de acordo com o MySQL instalado no PC onde o
# projeto vai rodar (no laboratório/apresentação).
#
#     cp .env.example .env
#
# Se o arquivo .env não existir, o projeto usa os valores padrão
# que estão em src/config/data-source.ts.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinica_odontologica

# Porta em que a API vai rodar (o frontend chama http://localhost:8080/api).
PORT=8080

# Endereço do frontend liberado no CORS.
CORS_ORIGIN=http://localhost:5173
